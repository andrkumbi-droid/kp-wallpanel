{
  "manifest_version": 3,
  "name": "KP Sortiment senden",
  "version": "1.0.0",
  "description": "Schickt in der Meta Business Suite alle lieferbaren KP-Produktfotos mit einem Klick in den Chat (10er-Schübe, Liste kommt aus der KP-App).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://business.facebook.com/*",
    "https://kp-wallpanel-default-rtdb.asia-southeast1.firebasedatabase.app/*",
    "https://andrkumbi-droid.github.io/*"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "content/selectors.js",
        "content/catalog-send.js",
        "content/overlay.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "content/main-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "KP Sortiment senden"
  }
}
