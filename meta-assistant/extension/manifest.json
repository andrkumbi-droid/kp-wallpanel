{
  "manifest_version": 3,
  "name": "KP Meta Assistant",
  "version": "0.4.0",
  "description": "Thai customer-service assistant for Meta Business Suite (KP Wallpanel). Translation, reply suggestions and one-click sending of all available product photos. No API keys in this extension.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://business.facebook.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://kp-wallpanel-default-rtdb.asia-southeast1.firebasedatabase.app/*",
    "https://andrkumbi-droid.github.io/*"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "content/selectors.js",
        "content/inbox-live.js",
        "content/composer.js",
        "content/catalog-send.js",
        "content/overlay.js",
        "content/inbox-observer.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://business.facebook.com/*"
      ],
      "js": [
        "content/main-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "action": {
    "default_title": "KP Meta Assistant"
  }
}
