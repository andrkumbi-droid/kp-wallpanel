{
  "rules": {
    ".read": "auth != null && auth.token.firebase.sign_in_provider != 'password'",
    ".write": "auth != null && auth.token.firebase.sign_in_provider != 'password'",

    "pub": {
      ".read": true,
      ".write": "auth != null"
    },

    "v2": {
      "auditLog": { ".indexOn": "ts" },
      "sales": {
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.child('uid').val() === $uid && newData.child('status').val() === (data.exists() ? data.child('status').val() : 'pending')"
          }
        },
        "requests": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$rid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('uid').val() === $uid && newData.child('status').val() === 'pending' && root.child('v2/sales/members/' + $uid + '/status').val() === 'active'"
            }
          }
        },
        "config": { ".read": "auth != null" }
      },
      "orders": {
        "$k": { ".read": "auth != null && data.child('salesUid').val() === auth.uid" }
      },
      "assistant": {
        "productCatalog": { ".read": "auth != null && root.child('v2/sales/members/' + auth.uid + '/status').val() === 'active'" }
      },
      "stockItems": { ".read": "auth != null && root.child('v2/sales/members/' + auth.uid + '/status').val() === 'active'" },
      "soldOut": { ".read": "auth != null && root.child('v2/sales/members/' + auth.uid + '/status').val() === 'active'" },
      "pushQueue": {
        "$id": { ".write": "auth != null && !data.exists() && newData.child('role').val() === 'office'" }
      }
    },

    "lagertest": {
      "sales": {
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.child('uid').val() === $uid && newData.child('status').val() === (data.exists() ? data.child('status').val() : 'pending')"
          }
        },
        "requests": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$rid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('uid').val() === $uid && newData.child('status').val() === 'pending' && root.child('lagertest/sales/members/' + $uid + '/status').val() === 'active'"
            }
          }
        },
        "config": { ".read": "auth != null" }
      },
      "orders": {
        "$k": { ".read": "auth != null && data.child('salesUid').val() === auth.uid" }
      },
      "assistant": {
        "productCatalog": { ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'" }
      },
      "stockItems": { ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'" },
      "soldOut": { ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'" },
      "pushQueue": {
        "$id": { ".write": "auth != null && !data.exists() && newData.child('role').val() === 'office'" }
      }
    }
  }
}
