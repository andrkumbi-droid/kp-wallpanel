{
  "rules": {
    "$top": {
      ".read": "auth != null && (auth.token.firebase.sign_in_provider != 'password' || auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1')",
      ".write": "auth != null && (auth.token.firebase.sign_in_provider != 'password' || auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1')"
    },
    "kpAuth": {
      ".read": "auth != null && auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1'",
      ".write": "auth != null && auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1'",
      "seen": {
        "$d": {
          ".write": "auth != null && (auth.token.firebase.sign_in_provider != 'password' || auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1')"
        }
      }
    },
    "pub": {
      ".read": true,
      ".write": "auth != null && (auth.token.firebase.sign_in_provider != 'password' || auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1')"
    },
    "v2": {
      ".read": "auth != null && (auth.token.firebase.sign_in_provider != 'password' || auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1')",
      ".write": "auth != null && (auth.token.firebase.sign_in_provider != 'password' || auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1')",
      "auditLog": {
        ".indexOn": "ts"
      },
      "invest": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'kp-invest@kp-wallpanel.firebaseapp.com'",
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && auth.token.email == 'kp-invest@kp-wallpanel.firebaseapp.com'"
      },
      "sales": {
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.child('uid').val() === $uid && newData.child('status').val() === (data.exists() ? data.child('status').val() : 'pending')"
          }
        },
        "requests": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$rid": {
              ".write": "auth != null && auth.uid === $uid && $rid.matches(/^[A-Za-z0-9_-]+$/) && $rid.length <= 40 && !data.exists() && newData.child('uid').val() === $uid && newData.child('status').val() === 'pending' && root.child('v2/sales/members/' + $uid + '/status').val() === 'active'"
            }
          }
        },
        "config": {
          ".read": "auth != null"
        }
      },
      "orders": {
        "$k": {
          ".read": "auth != null && data.child('salesUid').val() === auth.uid"
        }
      },
      "assistant": {
        "productCatalog": {
          ".read": "auth != null && root.child('v2/sales/members/' + auth.uid + '/status').val() === 'active'"
        }
      },
      "stockItems": {
        ".read": "auth != null && root.child('v2/sales/members/' + auth.uid + '/status').val() === 'active'"
      },
      "soldOut": {
        ".read": "auth != null && root.child('v2/sales/members/' + auth.uid + '/status').val() === 'active'"
      },
      "pushQueue": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('role').val() === 'office'"
        }
      }
    },
    "lagertest": {
      ".read": "auth != null && (auth.token.firebase.sign_in_provider != 'password' || auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1')",
      ".write": "auth != null && (auth.token.firebase.sign_in_provider != 'password' || auth.uid === '8H1zmzIea3h0AT9etyzMMjxdvNg1')",
      "sales": {
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && newData.child('uid').val() === $uid && newData.child('status').val() === (data.exists() ? data.child('status').val() : 'pending')"
          }
        },
        "requests": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$rid": {
              ".write": "auth != null && auth.uid === $uid && $rid.matches(/^[A-Za-z0-9_-]+$/) && $rid.length <= 40 && !data.exists() && newData.child('uid').val() === $uid && newData.child('status').val() === 'pending' && root.child('lagertest/sales/members/' + $uid + '/status').val() === 'active'"
            }
          }
        },
        "config": {
          ".read": "auth != null"
        }
      },
      "orders": {
        "$k": {
          ".read": "auth != null && data.child('salesUid').val() === auth.uid"
        }
      },
      "assistant": {
        "productCatalog": {
          ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'"
        }
      },
      "stockItems": {
        ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'"
      },
      "soldOut": {
        ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'"
      },
      "pushQueue": {
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('role').val() === 'office'"
        }
      }
    }
  }
}
