              "img": {
                ".validate": "newData.isBoolean()"
              },
              "ctx": {
                ".validate": "newData.isString() && newData.val().length <= 600"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "chatImg": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$mid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('lagertest/sales/members/' + $uid).exists() && root.child('lagertest/sales/members/' + $uid + '/status').val() !== 'blocked'",
              ".validate": "newData.isString() && newData.val().length <= 700000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/=]+$/)"
            }
          }
        },
        "chatSeen": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "partner": {
              ".write": "auth != null && auth.uid === $uid && newData.isNumber() && newData.val() <= now"
            }
          }
        },
        "reports": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$id": {
              ".write": "auth != null && auth.uid === $uid && $id.matches(/^[-_A-Za-z0-9]{1,40}$/) && !data.exists() && root.child('lagertest/sales/members/' + $uid).exists() && root.child('lagertest/sales/members/' + $uid + '/status').val() !== 'blocked' && newData.child('status').val() === 'new' && newData.child('ts').val() === now && !newData.child('de').exists() && !newData.child('reply').exists() && !newData.child('doneAt').exists() && !newData.child('seenP').exists()",
              ".validate": "newData.hasChildren(['cat','ts','status'])",
              "cat": {
                ".validate": "newData.val() === 'urgent' || newData.val() === 'bug' || newData.val() === 'undo' || newData.val() === 'wish'"
              },
              "text": {
                ".validate": "newData.isString() && newData.val().length <= 3000"
              },
              "els": {
                "$i": {
                  ".validate": "$i.matches(/^[0-9]$/) && newData.hasChildren(['d'])",
                  "d": {
                    ".validate": "newData.isString() && newData.val().length <= 600"
                  },
                  "sel": {
                    ".validate": "newData.isString() && newData.val().length <= 300"
                  },
                  "html": {
                    ".validate": "newData.isString() && newData.val().length <= 600"
                  },
                  "$o": {
                    ".validate": false
                  }
                }
              },
              "imgs": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "tab": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "dev": {
                ".validate": "newData.isString() && newData.val().length <= 300"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "status": {
                ".validate": "newData.val() === 'new' || newData.val() === 'seen' || newData.val() === 'work' || newData.val() === 'done'"
              },
              "de": {
                ".validate": "newData.isString() && newData.val().length <= 6000"
              },
              "reply": {
                ".validate": "newData.hasChildren(['th','ts'])",
                "th": {
                  ".validate": "newData.isString() && newData.val().length <= 3000"
                },
                "de": {
                  ".validate": "newData.isString() && newData.val().length <= 3000"
                },
                "ts": {
                  ".validate": "newData.isNumber()"
                },
                "$o": {
                  ".validate": false
                }
              },
              "doneAt": {
                ".validate": "newData.isNumber()"
              },
              "seenP": {
                ".write": "auth != null && auth.uid === $uid && data.parent().exists() && newData.val() === now",
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "reportImg": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            "$id": {
              "$i": {
                ".write": "auth != null && auth.uid === $uid && $i.matches(/^[0-2]$/) && (newData.val() === data.val() || (!data.exists() && root.child('lagertest/sales/members/' + $uid + '/status').val() !== 'blocked' && root.child('lagertest/sales/reports/' + $uid + '/' + $id + '/ts').val() > now - 86400000 && (($i === '0' && root.child('lagertest/sales/reports/' + $uid + '/' + $id + '/imgs').val() >= 1) || ($i === '1' && root.child('lagertest/sales/reports/' + $uid + '/' + $id + '/imgs').val() >= 2) || ($i === '2' && root.child('lagertest/sales/reports/' + $uid + '/' + $id + '/imgs').val() >= 3))))",
                ".validate": "newData.isString() && newData.val().length <= 700000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/=]+$/)"
              }
            }
          }
        }
      },
      "orders": {
        "$k": {
          ".read": "auth != null && data.child('salesUid').val() === auth.uid"
        }
      },
      "assistant": {
        "productCatalog": {
          ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'"
        }
      },
      "stockItems": {
        ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'"
      },
      "soldOut": {
        ".read": "auth != null && root.child('lagertest/sales/members/' + auth.uid + '/status').val() === 'active'"
      },
      "pushQueue": {
        "$id": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider == 'password' && root.child('lagertest/sales/members/' + auth.uid).exists() && newData.child('ts').isNumber() && newData.child('ts').val() <= now + 60000 && newData.child('title').isString() && newData.child('title').val().length <= 200 && (!newData.child('body').exists() || (newData.child('body').isString() && newData.child('body').val().length <= 500)) && !data.exists() && newData.child('role').val() === 'office'"
        }
      }
    }
  }
}
